{
  "name": "reedleaves",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.15.0 <25"
  },
  "scripts": {
    "build:ui": "node scripts/build-ui.mjs",
    "watch:ui": "node scripts/build-ui.mjs --watch",
    "prestart": "npm run build:ui",
    "pretest": "npm run build:ui",
    "start": "node server/index.mjs",
    "db:init": "node server/manage.mjs init",
    "db:seed": "node server/manage.mjs seed",
    "db:check": "node server/manage.mjs check",
    "db:leaves": "node server/manage.mjs leaves",
    "db:backup": "node server/manage.mjs backup",
    "test": "node --test app/*.test.mjs server/*.test.mjs"
  },
  "dependencies": {
    "pg": "^8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "esbuild": "0.28.2"
  }
}
